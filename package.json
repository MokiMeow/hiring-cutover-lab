  "repository": {
    "type": "git",
    "url": "https://github.com/MokiMeow/hiring-cutover-lab.git"
  },
  "homepage": "https://github.com/MokiMeow/hiring-cutover-lab#readme",
  "bugs": {
    "url": "https://github.com/MokiMeow/hiring-cutover-lab/issues"
  }
