{
  "name": "hiring-cutover-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "demo": "node src/main.mjs --demo",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "compare": "node src/cli.mjs compare",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "bootstrap": "5.3.9",
    "prettier": "3.10.1"
  },
  "description": "An offline hiring migration rehearsal with explicit mappings, blocking differences and reviewable evidence.",
